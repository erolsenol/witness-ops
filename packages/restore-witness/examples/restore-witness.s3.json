{
  "version": 1,
  "storageDirectory": "./backups",
  "timeoutSeconds": 600,
  "projects": {
    "example": {
      "environment": "development",
      "connectionEnv": "EXAMPLE_DATABASE_URL",
      "assertions": [
        {
          "schema": "public",
          "table": "accounts",
          "minimumRows": 1
        }
      ],
      "encryption": {
        "recipient": "REPLACE_WITH_YOUR_AGE_PUBLIC_RECIPIENT",
        "identityFileEnv": "EXAMPLE_AGE_IDENTITY_FILE"
      }
    }
  },
  "s3": {
    "bucket": "replace-with-your-backup-bucket",
    "region": "us-east-1",
    "endpoint": "https://replace-with-your-s3-endpoint.example",
    "prefix": "restore-witness",
    "forcePathStyle": true,
    "accessKeyEnv": "BACKUP_S3_ACCESS_KEY",
    "secretKeyEnv": "BACKUP_S3_SECRET_KEY"
  },
  "restoreTargets": {
    "recovery": {
      "environment": "test",
      "connectionEnv": "RECOVERY_DATABASE_URL"
    }
  }
}
