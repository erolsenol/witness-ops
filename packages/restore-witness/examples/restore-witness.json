{
  "version": 1,
  "storageDirectory": "./backups",
  "timeoutSeconds": 300,
  "projects": {
    "example": {
      "environment": "development",
      "connectionEnv": "EXAMPLE_DATABASE_URL",
      "assertions": [
        {
          "schema": "public",
          "table": "accounts",
          "minimumRows": 1
        }
      ]
    }
  },
  "restoreTargets": {
    "recovery": {
      "environment": "test",
      "connectionEnv": "RECOVERY_DATABASE_URL"
    }
  }
}
